let rows=[],datasetMode="1",thresholdA=70,thresholdB=75,selectedOp="union",filtered=[];
const $=id=>document.getElementById(id);
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function toast(msg){const t=$("toast");t.textContent=msg;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2500);}
function loadDataset(id){datasetMode=String(id);rows=(samples[id]||samples[1]).map((r,i)=>({id:i+1,nama:r[0],nilai:Number(r[1]),kehadiran:Number(r[2])}));$("datasetSelect").value=datasetMode;$("datasetSummary").textContent=`Dataset ${id} · ${rows.length} mahasiswa`;render();toast(`Dataset ${id} berhasil dimuat`);}
function sets(){const U=rows.slice(),A=U.filter(x=>x.nilai>=thresholdA),B=U.filter(x=>x.kehadiran>=thresholdB),ids=s=>new Set(s.map(x=>x.id));return {U,A,B,union:U.filter(x=>A.includes(x)||B.includes(x)),intersection:U.filter(x=>A.includes(x)&&B.includes(x)),aMinusB:U.filter(x=>A.includes(x)&&!B.includes(x)),bMinusA:U.filter(x=>B.includes(x)&&!A.includes(x)),compA:U.filter(x=>!A.includes(x)),compB:U.filter(x=>!B.includes(x)),neither:U.filter(x=>!A.includes(x)&&!B.includes(x))};}
const ops=[
{key:"union",symbol:"A ∪ B",name:"Gabungan (Union)",desc:"Anggota A atau B atau keduanya",color:"#5267f2"},
{key:"intersection",symbol:"A ∩ B",name:"Irisan (Intersection)",desc:"Anggota yang ada di A dan B",color:"#13a992"},
{key:"aMinusB",symbol:"A − B",name:"Selisih A − B",desc:"Anggota A yang bukan anggota B",color:"#6e7df4"},
{key:"bMinusA",symbol:"B − A",name:"Selisih B − A",desc:"Anggota B yang bukan anggota A",color:"#e65a9c"},
{key:"compA",symbol:"Aᶜ",name:"Komplemen A",desc:"Anggota U yang tidak ada di A",color:"#f1a23d"},
{key:"compB",symbol:"Bᶜ",name:"Komplemen B",desc:"Anggota U yang tidak ada di B",color:"#f1a23d"}
];
function vennSVG(s){let a=s.A.length,b=s.B.length,ab=s.intersection.length,onlyA=s.aMinusB.length,onlyB=s.bMinusA.length,out=s.neither.length;return `<svg viewBox="0 0 460 280" role="img" aria-label="Diagram Venn kategori A dan B"><rect x="0" y="0" width="460" height="280" rx="12" fill="#f8f9ff"/><rect x="18" y="18" width="424" height="244" rx="14" fill="#fff" stroke="#dce2f0" stroke-width="1.5"/><text x="34" y="42" font-size="12" font-weight="700" fill="#7a859c">U = ${s.U.length} DATA</text><circle cx="183" cy="142" r="86" fill="#7182ff" fill-opacity=".55" stroke="#586cf0" stroke-width="2"/><circle cx="277" cy="142" r="86" fill="#ef70b0" fill-opacity=".5" stroke="#e85b9f" stroke-width="2"/><text x="144" y="83" font-size="17" font-weight="800" fill="#394bd0">A</text><text x="311" y="83" font-size="17" font-weight="800" fill="#bd3f7f">B</text><text x="139" y="148" text-anchor="middle" font-size="24" font-weight="850" fill="#2536a5">${onlyA}</text><text x="230" y="148" text-anchor="middle" font-size="24" font-weight="850" fill="#087e70">${ab}</text><text x="320" y="148" text-anchor="middle" font-size="24" font-weight="850" fill="#a22e6b">${onlyB}</text><text x="230" y="239" text-anchor="middle" font-size="12" font-weight="700" fill="#738099">Di luar A dan B: ${out}</text></svg>`}
function memberNames(list){return list.length?list.map(x=>`<span class="member">${escapeHTML(x.nama)}</span>`).join(""):'<span class="sub">Tidak ada anggota</span>'}
function renderOps(target){const s=sets();$(target).innerHTML=ops.map(o=>`<button class="op-card ${selectedOp===o.key?'selected':''}" data-op="${o.key}"><div class="op-symbol" style="color:${o.color}">${o.symbol}</div><div class="op-name">${o.name}</div><div class="op-desc">${o.desc}</div><div class="op-count">${s[o.key].length} <span style="font-size:11px;color:#8b95a8;font-weight:600">anggota</span></div><div class="op-result">${s[o.key].slice(0,5).map(x=>escapeHTML(x.nama)).join(", ")}${s[o.key].length>5?"…":""}</div></button>`).join("");$(target).querySelectorAll("[data-op]").forEach(b=>b.addEventListener("click",()=>{selectedOp=b.dataset.op;render();showOperation(selectedOp)}));}
function renderTable(){const s=sets(),query=($("searchInput").value||"").toLowerCase(),filter=$("filterSelect").value;filtered=rows.filter(x=>{const a=x.nilai>=thresholdA,b=x.kehadiran>=thresholdB,cat=filter==="A"?a:filter==="B"?b:filter==="AB"?(a&&b):filter==="neither"?(!a&&!b):true;return x.nama.toLowerCase().includes(query)&&cat;});$("dataTable").innerHTML=filtered.length?filtered.map((x,i)=>{let a=x.nilai>=thresholdA,b=x.kehadiran>=thresholdB,cat=a&&b?'<span class="badge ab">A ∩ B</span>':a?'<span class="badge a">A saja</span>':b?'<span class="badge b">B saja</span>':'<span class="badge out">Di luar</span>';return `<tr><td>${i+1}</td><td><b>${escapeHTML(x.nama)}</b></td><td>${x.nilai}</td><td>${x.kehadiran}%</td><td>${cat}</td><td>${a&&b?"Memenuhi 2 kategori":a?"Memenuhi A":b?"Memenuhi B":"Belum memenuhi"}</td></tr>`}).join(""):'<tr><td colspan="6" class="empty">Tidak ada data yang cocok dengan filter.</td></tr>';$("tableCount").textContent=`Menampilkan ${filtered.length} dari ${rows.length} data`;}
function renderOpsTable(){const s=sets(),all=[["U","Semesta",s.U],...ops.map(o=>[o.symbol,o.name,s[o.key]])];$("opsTable").innerHTML=all.map(r=>`<tr><td><b>${r[0]}</b></td><td>${r[1]}</td><td><b>${r[2].length}</b></td><td>${r[2].map(x=>escapeHTML(x.nama)).join(", ")||"—"}</td></tr>`).join("");}
function showOperation(key){const s=sets(),o=ops.find(x=>x.key===key)||ops[0],list=s[key];let expl={union:"Anggota yang terdapat di A, di B, atau pada keduanya.",intersection:"Anggota yang memenuhi syarat kategori A dan kategori B sekaligus.",aMinusB:"Anggota yang memenuhi kategori A tetapi tidak memenuhi kategori B.",bMinusA:"Anggota yang memenuhi kategori B tetapi tidak memenuhi kategori A.",compA:"Anggota semesta U yang tidak memenuhi syarat kategori A.",compB:"Anggota semesta U yang tidak memenuhi syarat kategori B."}[key];$("operationDetail").innerHTML=`<h4>${o.symbol} — ${o.name}</h4><div class="sub">${expl}</div><div class="chips"><span class="chip">Kardinalitas: |hasil| = ${list.length}</span><span class="chip">Semesta: |U| = ${s.U.length}</span></div><div class="member-list">${memberNames(list)}</div>`;}
function render(){const s=sets();$("statTotal").textContent=s.U.length;$("statA").textContent=s.A.length;$("statB").textContent=s.B.length;$("statAB").textContent=s.intersection.length;$("vennDashboard").innerHTML=vennSVG(s);$("chipA").textContent=`A: ${s.A.length} anggota`;$("chipB").textContent=`B: ${s.B.length} anggota`;$("formulaExplain").textContent=`${s.A.length} + ${s.B.length} − ${s.intersection.length} = ${s.union.length}`;const calc=s.A.length+s.B.length-s.intersection.length,valid=calc===s.union.length;$("validationTitle").textContent=valid?"✓ Perhitungan valid":"⚠ Periksa perhitungan";$("validationText").textContent=valid?`Hasil rumus ${calc} sama dengan jumlah anggota A ∪ B (${s.union.length}).`:`Hasil rumus ${calc} tidak sama dengan jumlah gabungan ${s.union.length}.`;$("datasetSummary").textContent=`${datasetMode==="custom"?"Dataset unggahan":"Dataset "+datasetMode} · ${rows.length} mahasiswa`;$("descA").textContent=`A = {x ∈ U | nilai(x) ≥ ${thresholdA}} · ${s.A.length} anggota`;$("descB").textContent=`B = {x ∈ U | kehadiran(x) ≥ ${thresholdB}%} · ${s.B.length} anggota`;$("membersU").innerHTML=memberNames(s.U);$("membersA").innerHTML=memberNames(s.A);$("membersB").innerHTML=memberNames(s.B);renderOps("operationCards");renderOps("operationCards2");renderTable();renderOpsTable();showOperation(selectedOp);}
function goPage(page){document.querySelectorAll(".section").forEach(s=>s.classList.toggle("active",s.id===page));document.querySelectorAll(".nav").forEach(n=>n.classList.toggle("active",n.dataset.page===page));$("pageTitle").textContent={dashboard:"Dashboard Analisis",data:"Dataset & Kategori",operations:"Operasi Himpunan",guide:"Panduan Penggunaan"}[page]||"SetLab";window.scrollTo({top:0,behavior:"smooth"});}
document.querySelectorAll(".nav").forEach(n=>n.addEventListener("click",()=>goPage(n.dataset.page)));
$("startBtn").onclick=() => goPage("data");$("goDataBtn").onclick=()=>goPage("data");$("load1").onclick=()=>loadDataset(1);$("load2").onclick=()=>loadDataset(2);
$("datasetSelect").onchange=e=>{if(e.target.value!=="custom")loadDataset(Number(e.target.value));};
$("applyBtn").onclick=()=>{thresholdA=Math.max(0,Math.min(100,Number($("nilaiThreshold").value)||0));thresholdB=Math.max(0,Math.min(100,Number($("hadirThreshold").value)||0));$("nilaiThreshold").value=thresholdA;$("hadirThreshold").value=thresholdB;render();toast("Batas kategori berhasil diterapkan");};
$("searchInput").addEventListener("input",renderTable);$("filterSelect").addEventListener("change",renderTable);
$("fileInput").addEventListener("change",async e=>{const f=e.target.files[0];if(!f)return;try{const txt=await f.text(),parsed=parseCSV(txt);if(!parsed.length)throw Error("CSV kosong atau format tidak sesuai.");rows=parsed.map((r,i)=>({id:i+1,nama:String(r.Nama??r.nama??r.name??"").trim(),nilai:Number(r.Nilai??r.nilai??r.value),kehadiran:Number(r.Kehadiran??r.kehadiran??r.Presensi??r.presensi)})).filter(r=>r.nama&&Number.isFinite(r.nilai)&&Number.isFinite(r.kehadiran));if(!rows.length)throw Error("Pastikan ada kolom Nama, Nilai, dan Kehadiran.");datasetMode="custom";$("datasetSelect").value="custom";$("datasetSummary").textContent=`Dataset unggahan · ${rows.length} baris valid`;render();toast(`${rows.length} baris berhasil diimpor`);}catch(err){toast("Gagal membaca CSV: "+err.message);}});
function parseCSV(text){const lines=text.replace(/^\uFEFF/,"").trim().split(/\r?\n/);if(lines.length<2)return[];function split(line){let out=[],cur="",q=false;for(let i=0;i<line.length;i++){let c=line[i];if(c==='"'&&q&&line[i+1]==='"'){cur+='"';i++;}else if(c==='"')q=!q;else if(c===","&&!q){out.push(cur.trim());cur="";}else cur+=c;}out.push(cur.trim());return out;}const headers=split(lines[0]).map(h=>h.toLowerCase().replace(/^\ufeff/,""));return lines.slice(1).map(line=>{const vals=split(line),o={};headers.forEach((h,i)=>o[h]=vals[i]??"");return o;});}
function csvEscape(v){const s=String(v??"");return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;}
function downloadCSV(filename,content){const blob=new Blob(["\uFEFF"+content],{type:"text/csv;charset=utf-8;"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);}
$("downloadSource").onclick=()=>downloadCSV("dataset_aktif.csv","Nama,Nilai,Kehadiran\n"+rows.map(r=>[r.nama,r.nilai,r.kehadiran].map(csvEscape).join(",")).join("\n"));
$("exportAll").onclick=()=>{const s=sets(),head=["Nama","Nilai","Kehadiran","Kategori A","Kategori B","A union B","A intersection B","A-B","B-A","Komplemen A","Komplemen B"];const body=rows.map(r=>{const a=r.nilai>=thresholdA,b=r.kehadiran>=thresholdB;return [r.nama,r.nilai,r.kehadiran,a?"Ya":"Tidak",b?"Ya":"Tidak",a||b?"Ya":"Tidak",a&&b?"Ya":"Tidak",a&&!b?"Ya":"Tidak",b&&!a?"Ya":"Tidak",!a?"Ya":"Tidak",!b?"Ya":"Tidak"];});downloadCSV("hasil_klasifikasi_setlab.csv",[head,...body].map(r=>r.map(csvEscape).join(",")).join("\n"));toast("Hasil klasifikasi diekspor");};
$("exportOps").onclick=()=>{const s=sets(),data=[["Notasi","Operasi","Jumlah Anggota","Anggota"],["U","Semesta",s.U.length,s.U.map(x=>x.nama).join("; ")],...ops.map(o=>[o.symbol,o.name,s[o.key].length,s[o.key].map(x=>x.nama).join("; ")])];downloadCSV("ringkasan_operasi_himpunan.csv",data.map(r=>r.map(csvEscape).join(",")).join("\n"));};
$("resetBtn").onclick=()=>{thresholdA=70;thresholdB=75;$("nilaiThreshold").value=70;$("hadirThreshold").value=75;$("searchInput").value="";$("filterSelect").value="all";loadDataset(1);goPage("dashboard");toast("Aplikasi dikembalikan ke pengaturan awal");};
